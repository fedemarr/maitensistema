# ─────────────────────────────────────────────────────────────
# Copiá este archivo como .env.local y completá los valores.
# .env.local NO se versiona (está en .gitignore).
# En Vercel, cargá estas mismas variables en Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."

# Supabase → Project Settings → API (clave secreta / service_role).
# SOLO servidor. Nunca la expongas al cliente ni la pongas en una var NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (puerto 6543).
# La usa Drizzle para migraciones y queries del lado del servidor.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres"

# Anthropic → console.anthropic.com. SOLO servidor. La usa /api/analisis.
ANTHROPIC_API_KEY="sk-ant-..."
